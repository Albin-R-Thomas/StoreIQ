# Local development credentials only. Compose reads the same values.
POSTGRES_DB=store_iq
POSTGRES_USER=store_iq
POSTGRES_PASSWORD=store_iq_dev
DATABASE_URL=postgresql+asyncpg://store_iq:store_iq_dev@localhost:5432/store_iq

ENABLE_DEV_ROUTES=true
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=15
# Required only for AI_PROVIDER=openai. Choose a model supporting structured outputs.
OPENAI_API_KEY=
AI_MODEL=

# Local BM25 knowledge retrieval. Fixtures are synthetic, not official product data.
RAG_PROVIDER=bm25
RAG_CORPUS_PATH=fixtures/knowledge_base/documents.json
RAG_TOP_K=3
RAG_CHUNK_WORDS=160
RAG_OVERLAP_WORDS=30
RAG_K1=1.2
RAG_B=0.75

META_MODE=mock
# Active provider-neutral WhatsApp adapter. Only mock is implemented; other values fail closed.
# Mock endpoints additionally require ENABLE_DEV_ROUTES=true and DEMO_MODE=true.
WHATSAPP_PROVIDER=mock
# Voice uploads use actual speech recognition; this is independent of mock WhatsApp.
VOICE_PROVIDER=azure
# Used only if explicitly selecting the retained OpenAI adapter.
VOICE_MODEL=gpt-transcribe
VOICE_TRANSLATION_PROVIDER=azure
# Azure Speech resource (F0): required for combined audio transcription + translation.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional Azure Translator resource (F0): only for corrected text/changed targets.
AZURE_TRANSLATOR_KEY=
# Required for regional Translator resources; leave blank for a global resource.
AZURE_TRANSLATOR_REGION=
# Optional FFmpeg override; otherwise PATH or the imageio-ffmpeg wheel's bundled executable.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# Set these using your Meta test app before choosing META_MODE=live.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=
META_VERIFY_TOKEN=local-test-verify-token
META_APP_SECRET=local-test-app-secret
# JSON array of explicitly permitted TEST recipients; live sends fail closed.
META_TEST_RECIPIENTS=[]

# Current web application with reviewed voice uploads. Legacy Meta/recording routes are not mounted.
DEMO_MODE=true
# Explicit opt-in for deployments that intentionally retain the documented login passwords.
ALLOW_DEFAULT_PASSWORDS=false
WEB_DATABASE_PATH=data/store-iq.db
COOKIE_SECURE=false
# Set to the externally visible HTTPS origin behind your reverse proxy.
# PUBLIC_ORIGIN=https://store-iq.example.com
# With DEMO_MODE=false, set unique passwords before first startup (12+ characters).
# ASSOCIATE_PASSWORD=
# ASSOCIATE_TWO_PASSWORD=
# ADMIN_PASSWORD=
# The web application uses OPENAI_API_KEY and AI_MODEL directly. AI_PROVIDER is legacy.
# OPENAI_BASE_URL is supported by the SDK for local Postman simulation only.
