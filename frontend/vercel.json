{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://storeiq-api-44d6f926.centralindia.cloudapp.azure.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://storeiq-api-44d6f926.centralindia.cloudapp.azure.com/health/:path*"
    },
    { "source": "/((?!api(?:/|$)|health(?:/|$)).*)", "destination": "/index.html" }
  ]
}
